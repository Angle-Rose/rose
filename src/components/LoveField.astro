---
---

<div class="love-field" aria-hidden="true">
	<canvas class="love-field__canvas" data-love-field></canvas>
	<div class="love-field__fallback"></div>
</div>

<script>
	import { initLoveField } from '../scripts/love-field';

	const canvas = document.querySelector<HTMLCanvasElement>('[data-love-field]');

	if (canvas) {
		const field = initLoveField(canvas);

		window.addEventListener('letter:mood', (e) => {
			field.setMood((e as CustomEvent<number>).detail);
		});

		window.addEventListener('letter:act', (e) => {
			field.setAct((e as CustomEvent<number>).detail);
		});

		window.addEventListener('letter:open', () => {
			field.setOpen(1);
		});

		window.addEventListener('letter:cut', () => {
			field.cut();
		});
	}
</script>

<style>.love-field {
	position: fixed;
	inset: 0;
	z-index: -2;
	pointer-events: none;
	overflow: hidden;
	background: #f7dcea;
}
.love-field__canvas {
	position: absolute;
	inset: 0;
	width: 100%;
	height: 100%;
	display: block;
	opacity: 0;
	transition: opacity 1.4s var(--ease-out);
}
.love-field__canvas[data-ready='true'] {
	opacity: 1;
}
.love-field__fallback {
	position: absolute;
	inset: 0;
	display: none;
	background:
		radial-gradient(70% 55% at 22% 16%, rgba(255, 255, 255, 0.95), transparent 64%),
		radial-gradient(60% 50% at 82% 36%, rgba(233, 169, 199, 0.5), transparent 62%),
		radial-gradient(90% 70% at 50% 100%, rgba(199, 155, 198, 0.42), transparent 72%),
		linear-gradient(170deg, #fdf1f6 0%, #f7dcea 58%, #efd6e6 100%);
}
.love-field__canvas[data-webgl='off'] + .love-field__fallback {
	display: block;
}
</style>