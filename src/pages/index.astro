---
import BaseHead from '../components/BaseHead.astro';
import LoveField from '../components/LoveField.astro';
import {
	SITE_TITLE,
	SITE_DESCRIPTION,
	RECIPIENT,
	AUTHOR,
	TOGETHER_SINCE,
	TOGETHER_SINCE_ISO,
	LETTER,
	GATE,
	COUNTER,
	REPLAY,
	SIGN_KISSES,
	FOOTER_ORNAMENT,
} from '../consts';

const mark = (text: string) =>
	text
		.split(/(\[\[.*?\]\])/g)
		.map((part) =>
			part.startsWith('[[') ? `<em class="hl">${part.slice(2, -2)}</em>` : part
		)
		.join('');
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<script is:inline>
			document.documentElement.classList.add('js');
			document.body.classList.add('is-sealed');
		</script>
	</head>

	<body>
		<a class="skip-link" href="#letter">Skip to the letter</a>

		<LoveField />

		<div class="petals" data-petals aria-hidden="true"></div>
		<div class="love-float-layer" data-love aria-hidden="true"></div>
		<div class="progress" data-progress aria-hidden="true"></div>
		<div class="flash" aria-hidden="true"></div>

		
		<section class="gate" data-gate aria-label="A sealed letter">
			<div class="gate__inner">
				<p class="eyebrow gate__eyebrow">{GATE.eyebrow}</p>

				<h1 class="gate__title">
					For <span>{RECIPIENT}</span>
				</h1>

				<p class="gate__sub">{GATE.sub}</p>

				<button class="seal" type="button" data-open aria-label="Open the letter">
					<span class="seal__ring" aria-hidden="true"></span>
					<span class="seal__heart" aria-hidden="true">❤</span>
					<span class="seal__label" aria-hidden="true">{GATE.open}</span>
				</button>

				<p class="gate__hint">{GATE.hint}</p>
				<p class="gate__note">{GATE.note}</p>
				<p class="ornament" aria-hidden="true">{GATE.ornament}</p>
			</div>
		</section>

		<main id="main">
			
			<article class="letter" id="letter">
				<div class="shell">
					<h2 class="letter__salutation" data-reveal>{LETTER.salutation}</h2>

					<div class="letter__body">
						{
							LETTER.paragraphs.map((para, i) => (
								<p data-reveal set:html={mark(para)} />
							))
						}

						<div class="letter__signoff" data-reveal="sign">
							<p class="letter__closing">{LETTER.closing}</p>
							<span class="letter__name">
								{AUTHOR}
								<svg viewBox="0 0 300 40" preserveAspectRatio="none" aria-hidden="true">
									<path d="M4 26 C 60 8, 110 34, 168 18 C 214 6, 258 24, 296 12" />
								</svg>
							</span>
							<p class="letter__kisses" aria-hidden="true">{SIGN_KISSES}</p>
						</div>
					</div>
				</div>

				<div class="scroll-cue" aria-hidden="true">
					keep reading
					<i></i>
				</div>
			</article>

			
			<section class="together" id="together" data-together data-since={TOGETHER_SINCE_ISO}>
				<div class="shell">
					<div class="together__head" data-reveal>
						<p class="eyebrow">{COUNTER.eyebrow}</p>
						<h2 class="together__title">{COUNTER.title}</h2>
						<p class="together__since">{TOGETHER_SINCE}</p>
						<p class="ornament" aria-hidden="true">{COUNTER.ornament}</p>
					</div>

					<div class="clock" data-reveal style="--d: 120ms">
						{
							COUNTER.units.map((unit) => (
								<div class="clock__cell" data-unit>
									<span class="clock__value">00</span>
									<span class="clock__unit">{unit}</span>
								</div>
							))
						}
					</div>
				</div>
			</section>

			
			<footer class="footer">
				<div class="shell">
					<p class="footer__seal">
						With all my heart, <span>{AUTHOR}</span>
					</p>
					<p class="footer__line">Since <b>{TOGETHER_SINCE}</b></p>

					<p class="ornament ornament--footer" aria-hidden="true">{FOOTER_ORNAMENT}</p>

					<div class="footer__actions">
						<button class="btn btn--ghost" type="button" data-replay data-magnetic="0.25">
							{REPLAY}
						</button>
					</div>

					<p class="footer__fine">
						made for {RECIPIENT} <span class="footer__heart" aria-hidden="true">❤</span> and only
						for {RECIPIENT}
					</p>
				</div>
			</footer>
		</main>

		<script>
			import '../scripts/site';
		</script>
	</body>
</html>